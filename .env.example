# URL du site canonique (à vérifier avant ouverture publique)
NUXT_PUBLIC_SITE_URL=https://domoklub.fr
# Ne passer à true qu'après la recette et la validation de publication.
NUXT_PUBLIC_SITE_LIVE=false
# API Strapi privée accessible au serveur Nuxt ; aucune donnée n'est publiée sans approbation
NUXT_STRAPI_URL=
# Jeton de lecture côté serveur uniquement, avec accès limité aux collections publiques.
NUXT_STRAPI_TOKEN=
# Identifiant Partenaire Amazon.fr (se termine par -21). Vide = aucune offre Amazon affichée.
AMAZON_PARTNER_TAG=
# Newsletter (Resend) : clé API (accès complet) et expéditeur d'un domaine vérifié dans Resend
RESEND_API_KEY=
NEWSLETTER_FROM=DomoKlub <newsletter@domoklub.fr>
# Facultatif : identifiant du segment Resend où ranger les inscrits
RESEND_SEGMENT_ID=
